# ==============================================================
# HTMLDropHub Environment Configuration
# ==============================================================
# All site settings (server, limits, API keys, Google OAuth, and the
# per-user API key limit) live in a JSON file:
#   data/config.json
# The file is created automatically on first launch. You can point
# to a different location with CONFIG_FILE.

# Optional: custom configuration file path
# CONFIG_FILE=./data/config.json

# Optional: persistent storage directory (defaults to ./data)
# DATA_DIR=./data

# Docker Compose only: host port mapped to the container's port 3000.
# If you change "server.port" in config.json, update the container side
# of the port mapping in docker-compose.yml as well.
PORT=3000

# (Optional) Cloudflare Tunnel Token if running with the tunnel compose service
# TUNNEL_TOKEN=eyJh...
