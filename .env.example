# ==============================================================
# HTMLDropHub Environment Configuration
# ==============================================================

# Server listening port inside container / host
PORT=3000

# Public base URL of your HTMLDropHub instance (used in MCP tool return URLs)
# Example: https://tools.poiu124.cyou or http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Strong master password for the /admin portal
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Default maximum file size allowed for uploaded HTML micro-apps in MB
MAX_FILE_SIZE_MB=15

# Whether guests can view the public catalog at '/' (true or false)
ALLOW_PUBLIC_CATALOG=true

# Persistent storage directory (defaults to ./data)
DATA_DIR=./data

# (Optional) Cloudflare Tunnel Token if running with the tunnel compose service
# TUNNEL_TOKEN=eyJh...
